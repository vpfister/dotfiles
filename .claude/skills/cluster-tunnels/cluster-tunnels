#!/usr/bin/env zsh
#
# cluster-tunnels — open laptop-relayed SSH tunnels so a "source" cluster
# can reach destination clusters it cannot route to directly, and (optionally)
# reach the laptop itself. The laptop is the pivot:
#
#     laptop  --(-L)-->  dest:22                       (one per destination)
#     source  --(-R)-->  laptop  --(-L)-->  dest:22    (reach dest from source)
#     source  --(-R)-->  laptop:22                     (reach the LAPTOP from source, host "mac")
#
# Usage:
#   cluster-tunnels [up|down|status|config]
#     up      open all tunnels (default), print the source-side ssh config, and
#             (on macOS, if MANAGE_MAC_SSHD) enable Remote Login
#     down    close all tunnels; (on macOS, if MANAGE_MAC_SSHD) disable Remote Login
#     status  show tunnel state, and (on macOS) whether the Mac's sshd is serving
#     config  just print the source-side ~/.ssh/config block
#
set -euo pipefail

# ============================ Configuration ============================

# The cluster you want to initiate connections FROM.
SOURCE_HOST="rno"

# Your username on the destination clusters (used only in the printed config).
DEST_USER="vincent.pfister"

# Destinations reachable from the laptop.
# Each entry: "<ssh-host>  <laptop_local_port>  <source_remote_port>"
#   laptop_local_port  : port on the laptop for the -L forward to <ssh-host>:22
#   source_remote_port : port on SOURCE_HOST that maps back to <ssh-host>
DESTINATIONS=(
  # "ala0  2200  12222"   # ALA decommissioned — uncomment to re-enable
  "bar   2201  12223"
)

# Expose the laptop's OWN sshd back to the source, so the source can
# `ssh $MAC_HOST` into the laptop. This is just the reverse leg pointed at
# laptop:22 instead of at a destination.
# Leave EXPOSE_LAPTOP_PORT empty ("") to disable.
EXPOSE_LAPTOP_PORT="12224"     # port on SOURCE_HOST that maps back to laptop:22
MAC_HOST="mac"                 # ssh alias created on the source
MAC_USER="vincent.pfister"     # your username on the Mac (must match `whoami`, case-sensitive)

# When EXPOSE_LAPTOP_PORT is set AND we're running on macOS (laptop == the Mac),
# also manage the Mac's own Remote Login (sshd) as part of up/down/status:
#   up     -> enable Remote Login
#   down   -> disable Remote Login
#   status -> report whether sshd serves on :22
# The per-user SSH access list (com.apple.access_ssh SACL) is intentionally NOT
# managed here — decouple sshd from it once via `pam_sacl -> optional` in
# /etc/pam.d/sshd (see SKILL.md). That removes the moving part that used to drop
# the connection right after Touch ID.
# Needs sudo; `systemsetup -setremotelogin` also needs your TERMINAL to have Full
# Disk Access. Set to "" to leave the Mac's sshd completely untouched.
MANAGE_MAC_SSHD="yes"

# Keep the Mac's sshd loaded *between* `up` runs: install a root LaunchDaemon that
# re-bootstraps com.openssh.sshd every MAINTAIN_INTERVAL seconds (in case sleep /
# policy sync unloads it). With pam_sacl -> optional in place this is only sshd
# insurance — no access-group churn. `up` installs+loads it; `down` removes it.
# Needs sudo once (to install). "" to disable.
MAINTAIN_MAC_ACCESS="yes"
MAINTAIN_INTERVAL=60
MAINTAIN_LABEL="com.vpfister.macssh-maintain"
MAINTAIN_PLIST="/Library/LaunchDaemons/${MAINTAIN_LABEL}.plist"
MAINTAIN_SCRIPT="/usr/local/sbin/cluster-tunnels-macssh"

# Dedicated control sockets for this script (kept separate from your
# interactive masters so they can be managed independently).
SOCKET_DIR="$HOME/.ssh/sockets/tunnels"

# Options shared by every tunnel master connection.
SSH_COMMON=(
  -o ConnectTimeout=10             # fail fast on an unreachable/unknown host
  -o ExitOnForwardFailure=yes      # fail loudly if a forward can't bind
  -o ServerAliveInterval=30
  -o ServerAliveCountMax=3
  -o ControlMaster=yes
  -o ControlPersist=yes            # stay up until `down`; survives the shell
)

# =======================================================================

mkdir -p "$SOCKET_DIR"; chmod 700 "$SOCKET_DIR"

_sock()  { print -r -- "$SOCKET_DIR/$1"; }

_is_up() {  # tag host
  ssh -O check -o ControlPath="$(_sock "$1")" "$2" >/dev/null 2>&1
}

_stop()  {  # tag host
  if _is_up "$1" "$2"; then
    ssh -O exit -o ControlPath="$(_sock "$1")" "$2" >/dev/null 2>&1 || true
    print -r -- "  closed:    $1 ($2)"
  fi
  rm -f "$(_sock "$1")"
}

# ---- macOS Remote Login (the "mac" host's sshd) management ----
_is_macos()      { [[ "$(uname)" == "Darwin" ]]; }
_manage_mac()    { _is_macos && [[ -n "$EXPOSE_LAPTOP_PORT" && -n "$MANAGE_MAC_SSHD" ]]; }
_mac_sshd_live() { bash -c 'exec 3<>/dev/tcp/127.0.0.1/22' 2>/dev/null; }  # sudo-free

_mac_sshd_up() {
  _manage_mac || return 0
  # nothing to do if sshd is already serving (access is decoupled from the SACL
  # via pam_sacl -> optional in /etc/pam.d/sshd, so serving == reachable)
  if _mac_sshd_live; then
    print -r -- "  mac sshd:  already serving on :22"
    return 0
  fi
  # We need sudo. Authenticate VISIBLY first — otherwise the suppressed sudo
  # calls below hide the password prompt and the script just looks hung. Note:
  # sudo Touch ID does NOT work inside tmux without pam_reattach, so this may ask
  # for your password instead of a fingerprint.
  print -r -- "  mac sshd:  sudo needed to enable Remote Login"
  print -r -- "             (Touch ID if pam_reattach is set up, else type your Mac password + Enter)"
  if ! sudo -v -p '  [sudo] Mac password for %u (type it, then press Enter): '; then
    print -r -- "  ! sudo not authorized — skipping mac sshd setup (run 'sudo -v' first; for Touch ID in tmux install pam_reattach)"
    return 0
  fi
  sudo systemsetup -f -setremotelogin on >/dev/null 2>&1 \
    || print -r -- "  ! couldn't enable Remote Login — grant your TERMINAL Full Disk Access, or toggle it in System Settings > Sharing"
}

_mac_sshd_down() {
  _manage_mac || return 0
  print -r -- "  mac sshd:  sudo needed to disable Remote Login"
  print -r -- "             (Touch ID if pam_reattach is set up, else type your Mac password + Enter)"
  if ! sudo -v -p '  [sudo] Mac password for %u (type it, then press Enter): '; then
    print -r -- "  ! sudo not authorized — leaving Remote Login as-is (run 'sudo -v' first)"
    return 0
  fi
  sudo systemsetup -f -setremotelogin off >/dev/null 2>&1 \
    || print -r -- "  ! couldn't disable Remote Login (needs Full Disk Access)"
}

_mac_sshd_status() {
  _is_macos || return 0
  [[ -n "$EXPOSE_LAPTOP_PORT" ]] || return 0
  if _mac_sshd_live; then
    print -r -- "  UP    mac sshd (:22 serving)"
  else
    print -r -- "  DOWN  mac sshd (:22 not serving — Remote Login off?)"
  fi
  if [[ -f "$MAINTAIN_PLIST" ]]; then
    print -r -- "  OK    mac maintainer installed ($MAINTAIN_LABEL, every ${MAINTAIN_INTERVAL}s)"
  else
    print -r -- "  --    mac maintainer not installed"
  fi
}

_mac_maintain_install() {
  _is_macos || return 0
  [[ -n "$EXPOSE_LAPTOP_PORT" && -n "$MAINTAIN_MAC_ACCESS" ]] || return 0
  print -r -- "  mac access: installing per-minute maintainer ($MAINTAIN_LABEL, root LaunchDaemon)"
  sudo -v -p '  [sudo] Mac password for %u (type it, then press Enter): ' || { print -r -- "  ! sudo not authorized; skipping maintainer install"; return 0; }
  sudo mkdir -p "${MAINTAIN_SCRIPT:h}"
  sudo tee "$MAINTAIN_SCRIPT" >/dev/null <<'EOF'
#!/bin/sh
# Managed by cluster-tunnels — keeps this Mac's sshd loaded (runs as root).
# SSH access is decoupled from the com.apple.access_ssh SACL via pam_sacl -> optional
# in /etc/pam.d/sshd, so this only has to keep the sshd LaunchDaemon up.
/bin/launchctl enable system/com.openssh.sshd 2>/dev/null
/bin/launchctl bootstrap system /System/Library/LaunchDaemons/ssh.plist 2>/dev/null
EOF
  sudo chown root:wheel "$MAINTAIN_SCRIPT"; sudo chmod 755 "$MAINTAIN_SCRIPT"
  sudo tee "$MAINTAIN_PLIST" >/dev/null <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$MAINTAIN_LABEL</string>
  <key>ProgramArguments</key><array><string>$MAINTAIN_SCRIPT</string></array>
  <key>StartInterval</key><integer>$MAINTAIN_INTERVAL</integer>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
PLIST
  sudo chown root:wheel "$MAINTAIN_PLIST"; sudo chmod 644 "$MAINTAIN_PLIST"
  sudo launchctl bootout system "$MAINTAIN_PLIST" 2>/dev/null || true
  sudo launchctl bootstrap system "$MAINTAIN_PLIST" 2>/dev/null || print -r -- "  ! couldn't load the maintainer LaunchDaemon"
  sudo launchctl enable "system/$MAINTAIN_LABEL" 2>/dev/null || true
  print -r -- "  mac access: maintainer active (re-checks every ${MAINTAIN_INTERVAL}s)"
}

_mac_maintain_remove() {
  _is_macos || return 0
  [[ -f "$MAINTAIN_PLIST" ]] || return 0
  print -r -- "  mac access: removing per-minute maintainer"
  sudo -v -p '  [sudo] Mac password for %u (type it, then press Enter): ' || { print -r -- "  ! sudo not authorized; leaving maintainer in place"; return 0; }
  sudo launchctl bootout system "$MAINTAIN_PLIST" 2>/dev/null || true
  sudo rm -f "$MAINTAIN_PLIST" "$MAINTAIN_SCRIPT"
}

up() {
  # 0) (macOS) make sure the laptop's own sshd is reachable as "mac"
  _mac_sshd_up
  _mac_maintain_install

  # 1) local forwards: laptop -> each destination. A host that can't be opened
  #    (unknown / renamed / unreachable) is skipped with a warning instead of
  #    crashing the whole run; remember which came up so only those get a
  #    matching reverse forward below.
  local live=()   # entries "lport rport" for destinations whose -L is up
  for entry in $DESTINATIONS; do
    local parts=(${=entry}); local name=$parts[1] lport=$parts[2] rport=$parts[3]
    local tag="L-$name"
    if _is_up "$tag" "$name"; then
      print -r -- "  already up: $tag"
      live+=("$lport $rport")
    else
      print -r -- "  opening:   laptop:$lport -> $name:22   (Touch ID may prompt)"
      if ssh -f -N $SSH_COMMON -o ControlPath="$(_sock "$tag")" \
           -L "127.0.0.1:${lport}:localhost:22" "$name"; then
        live+=("$lport $rport")
      else
        print -r -- "  ! skipped $name — couldn't open its -L forward (unknown/renamed/unreachable?); continuing"
      fi
    fi
  done

  # 2) one reverse connection to SOURCE carrying a -R for each LIVE destination
  local rflags=()
  for d in $live; do
    local dp=(${=d}); rflags+=(-R "127.0.0.1:${dp[2]}:127.0.0.1:${dp[1]}")
  done
  # optional: expose the laptop's own sshd back to the source as host "mac"
  if [[ -n "$EXPOSE_LAPTOP_PORT" ]]; then
    rflags+=(-R "127.0.0.1:${EXPOSE_LAPTOP_PORT}:127.0.0.1:22")
  fi
  if (( ${#rflags} == 0 )); then
    print -r -- "  (nothing to forward to $SOURCE_HOST — no live destinations)"
    return 0
  fi
  local tag="R-$SOURCE_HOST"
  if _is_up "$tag" "$SOURCE_HOST"; then
    print -r -- "  already up: $tag"
  else
    print -r -- "  opening:   $SOURCE_HOST reverse forwards   (Touch ID may prompt)"
    ssh -f -N $SSH_COMMON -o ControlPath="$(_sock "$tag")" $rflags "$SOURCE_HOST" \
      || print -r -- "  ! couldn't open reverse connection to $SOURCE_HOST"
  fi
}

down() {
  _stop "R-$SOURCE_HOST" "$SOURCE_HOST"
  for entry in $DESTINATIONS; do
    local parts=(${=entry}); _stop "L-$parts[1]" "$parts[1]"
  done
  # (macOS) stop the per-minute maintainer, then disable Remote Login
  _mac_maintain_remove
  _mac_sshd_down
}

status() {
  if _is_up "R-$SOURCE_HOST" "$SOURCE_HOST"; then
    print -r -- "  UP    R-$SOURCE_HOST${EXPOSE_LAPTOP_PORT:+  (carries dests + $MAC_HOST)}"
  else
    print -r -- "  DOWN  R-$SOURCE_HOST"
  fi
  for entry in $DESTINATIONS; do
    local parts=(${=entry}); local name=$parts[1]
    if _is_up "L-$name" "$name"; then
      print -r -- "  UP    L-$name"
    else
      print -r -- "  DOWN  L-$name"
    fi
  done
  # (macOS) report the mac host's own sshd + access state
  _mac_sshd_status
}

_print_host_block() {  # host port user alias
  print -r -- ""
  print -r -- "Host $1"
  print -r -- "    HostName 127.0.0.1"
  print -r -- "    Port $2"
  print -r -- "    User $3"
  print -r -- "    HostKeyAlias $4"
  print -r -- "    StrictHostKeyChecking accept-new"
  print -r -- "    ControlMaster auto"
  print -r -- "    ControlPath ~/.ssh/sockets/%C"
  print -r -- "    ControlPersist 60m"
}

print_config() {
  print -r -- "# ===== add to ~/.ssh/config on $SOURCE_HOST ====="
  print -r -- "# one-time setup ON $SOURCE_HOST:"
  print -r -- "#   1) mkdir -p ~/.ssh/sockets && chmod 700 ~/.ssh/sockets   (for ControlPath)"
  print -r -- "#   2) log in to $SOURCE_HOST with agent forwarding (ssh -A $SOURCE_HOST) so your"
  print -r -- "#      forwarded key authenticates onward to the destinations / the Mac"
  for entry in $DESTINATIONS; do
    local parts=(${=entry}); local name=$parts[1] rport=$parts[3]
    _print_host_block "$name" "$rport" "$DEST_USER" "$name-via-tunnel"
  done
  if [[ -n "$EXPOSE_LAPTOP_PORT" ]]; then
    _print_host_block "$MAC_HOST" "$EXPOSE_LAPTOP_PORT" "$MAC_USER" "mac-via-tunnel"
    print -r -- "    # '$MAC_HOST' is your laptop. On the Mac: this script's 'up' enables Remote"
    print -r -- "    #   Login; you still need your key in ~/.ssh/authorized_keys (append"
    print -r -- "    #   'ssh-add -L' on the laptop) and pam_sacl -> optional in /etc/pam.d/sshd."
  fi
}

case "${1:-up}" in
  up)     up; print -r -- ""; print_config ;;
  down)   down ;;
  status) status ;;
  config) print_config ;;
  *)      print -r -- "usage: ${0:t} [up|down|status|config]" >&2; exit 2 ;;
esac
