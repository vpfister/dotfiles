#!/usr/bin/env python3
"""gh wrapper: in agent shells, refuse merges; everything else passes through.

The check reads argv, which the shell has already parsed, so heredocs and quoting
in the surrounding command cannot confuse it. Approved merges go through
`gh-approved`, which a settings.json ask rule gates behind Vincent's prompt.
Codex shells have no such prompt, so they cannot use `gh-approved`.
"""

import os
import re
import sys
from pathlib import Path

MERGE = re.compile(r"/merge\b|mergePullRequest|PullRequestAutoMerge|enqueuePullRequest|merge-queue", re.I)
SELF_DIR = Path(__file__).resolve().parent


def real_gh() -> str:
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(entry or ".") / "gh"
        if candidate.resolve().parent != SELF_DIR and os.access(candidate, os.X_OK):
            return str(candidate)
    sys.exit("gh wrapper: no real gh found on PATH")


def in_agent() -> bool:
    return os.environ.get("CLAUDECODE") == "1" or "CODEX_THREAD_ID" in os.environ


def is_merge(args: list[str]) -> bool:
    if args[:2] in (["pr", "merge"], ["stack", "merge"]):
        return True
    if args[:1] != ["api"]:
        return False
    texts = list(args)
    for i, arg in enumerate(args):
        # GraphQL or JSON bodies may come from a file: -F query=@file, --input file.
        name = arg.partition("=")[2] if "=@" in arg else None
        path = name[1:] if name and name.startswith("@") else None
        if arg == "--input" and i + 1 < len(args):
            path = args[i + 1]
        if path and path != "-":
            try:
                texts.append(Path(path).read_text(errors="replace"))
            except OSError:
                return True  # unreadable body: treat as a possible merge
        if arg == "--input" and args[i + 1:i + 2] == ["-"]:
            return True  # stdin body cannot be inspected
    return any(MERGE.search(text) for text in texts)


def main() -> None:
    args = sys.argv[1:]
    approved = Path(sys.argv[0]).name == "gh-approved"
    if in_agent() and is_merge(args):
        if not approved:
            sys.exit("Merges need Vincent's approval. Ask him, and only after his explicit go rerun the "
                     "same command with `gh-approved` in place of `gh`.")
        if "CODEX_THREAD_ID" in os.environ:
            sys.exit("Codex sessions cannot merge. Ask Vincent to merge.")
    os.execv(real_gh(), ["gh", *args])


if __name__ == "__main__":
    main()
