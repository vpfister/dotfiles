# Included only by with-agent-github. Keep canonical .git URLs to limit prefix matching.
[url "https://github.com/mistralai/mistral.git"]
    insteadOf = git@github.com:mistralai/mistral.git
    insteadOf = ssh://git@github.com/mistralai/mistral.git
[credential "https://github.com/mistralai/mistral.git"]
    helper =
    helper = !gh auth git-credential
    useHttpPath = true
    username = vpfister

[url "https://github.com/mistralai/vortex.git"]
    insteadOf = git@github.com:mistralai/vortex.git
    insteadOf = ssh://git@github.com/mistralai/vortex.git
[credential "https://github.com/mistralai/vortex.git"]
    helper =
    helper = !gh auth git-credential
    useHttpPath = true
    username = vpfister

[url "https://github.com/mistralai/registry.git"]
    insteadOf = git@github.com:mistralai/registry.git
    insteadOf = ssh://git@github.com/mistralai/registry.git
[credential "https://github.com/mistralai/registry.git"]
    helper =
    helper = !gh auth git-credential
    useHttpPath = true
    username = vpfister

# Own namespace: a prefix rule on purpose, so every vpfister repo is covered.
[url "https://github.com/vpfister/"]
    insteadOf = git@github.com:vpfister/
    insteadOf = ssh://git@github.com/vpfister/
[credential "https://github.com/vpfister"]
    helper =
    helper = !gh auth git-credential
    username = vpfister
